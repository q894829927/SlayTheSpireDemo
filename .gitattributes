# ============================================================
# Default text handling
# ============================================================

* text=auto

# ============================================================
# Source code
# ============================================================

*.h text
*.hpp text
*.c text
*.cc text
*.cpp text
*.cs text

*.ini text
*.json text
*.xml text
*.yaml text
*.yml text
*.toml text

*.md text
*.txt text

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ============================================================
# Unreal Engine assets
# Git LFS
# ============================================================

*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

# ============================================================
