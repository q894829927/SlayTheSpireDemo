# IDE / Compiler
# ============================================================

*.VC.db
*.VC.VC.opendb
*.opendb
*.opensdf
*.sdf
*.suo
*.user
*.userprefs
*.sln.docstates

# Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# ============================================================
# Operating System
# ============================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

