# Build outputs
Build/Receipts/
Build/BatchFiles/

# Packaged builds
Builds/
Packaged/
StagedBuilds/

# ============================================================
# Plugins
# ============================================================

# Ignore generated plugin files, but keep plugin source/content
Plugins/*/Binaries/
Plugins/*/Intermediate/
Plugins/*/DerivedDataCache/
Plugins/*/Saved/

# Recursive plugin generated directories
Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/**/DerivedDataCache/
Plugins/**/Saved/

